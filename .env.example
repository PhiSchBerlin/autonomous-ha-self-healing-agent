# ============================================================
# HA Self-Healing Agent — Konfigurationsvorlage
# Kopieren nach .env und Werte anpassen.
# NIEMALS .env in die Versionskontrolle einchecken!
# ============================================================

# ------------------------------------------------------------------
# App
# ------------------------------------------------------------------
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
HOST=0.0.0.0
PORT=8765

# ------------------------------------------------------------------
# LLM-Backend (Standard: Ollama lokal)
# Verfügbare Typen: ollama, lm_studio, vllm, local_ai, tabby_api,
#                   llama_cpp, anthropic, openai, gemini, openrouter
# ------------------------------------------------------------------
LLM_BACKEND_TYPE=ollama
LLM_MODEL=qwen2.5-coder:14b
# Im Docker-Container: host.docker.internal statt localhost verwenden
LLM_BASE_URL=http://localhost:11434
# LLM_API_KEY=sk-...          # Nur für Cloud-Backends
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_ANONYMIZE_SENSITIVE_DATA=true
LLM_CLOUD_ENABLED=false

# ------------------------------------------------------------------
# Agent-Modus (advisory | approval | autonomous)
#   advisory   — Nur Empfehlungen, keine automatischen Änderungen
#   approval   — Änderungen erst nach manueller Genehmigung
#   autonomous — Vollautomatisch (nur für erfahrene Nutzer!)
# ------------------------------------------------------------------
AGENT_MODE=advisory
AGENT_MAX_ITERATIONS=10
AGENT_APPROVAL_TIMEOUT_SECONDS=3600
AGENT_DRY_RUN=true
AGENT_AUTO_BACKUP=true

# ------------------------------------------------------------------
# Home Assistant Verbindung
# ------------------------------------------------------------------
HA_URL=http://homeassistant.local:8123
# HA_TOKEN=eyJ...             # Long-Lived Access Token (Pflichtfeld)
HA_CONFIG_PATH=/config
HA_VERIFY_SSL=true
HA_WEBSOCKET_TIMEOUT=30

# Lokaler HA-Config-Pfad für Security-Scans
# (Pfad auf dem Docker-Host, wird als Volume gemountet)
HA_CONFIG_PATH_HOST=/path/to/homeassistant/config

# ------------------------------------------------------------------
# Sicherheitseinstellungen des Agents selbst
# ------------------------------------------------------------------
SECURITY_ALLOW_AUTONOMOUS_FILE_WRITES=false
SECURITY_ALLOW_SHELL_EXECUTION=false
SECURITY_ALLOW_DOCKER_ACCESS=false
SECURITY_MAX_FILE_SIZE_BYTES=10485760

# ------------------------------------------------------------------
# Docker-Compose Ports (nur für lokale Anpassung nötig)
# ------------------------------------------------------------------
AGENT_PORT=8765
DASHBOARD_PORT=8501
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
DASHBOARD_REFRESH_SECONDS=30

# ------------------------------------------------------------------
# Grafana (Passwort in Produktion unbedingt ändern!)
# ------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_in_production
