{
  "title": "HA Self-Healing Agent",
  "uid": "ha-agent-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "tags": ["home-assistant", "self-healing"],
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Agent-Läufe gesamt",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "sum(ha_agent_runs_total)",
          "legendFormat": "Gesamt"
        }
      ],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Aktive Läufe",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "sum(ha_agent_active_runs)",
          "legendFormat": "Aktiv"
        }
      ],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "HA WebSocket",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "ha_websocket_connected",
          "legendFormat": "Verbunden"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "mappings": [
          { "type": "value", "options": { "0": { "text": "GETRENNT", "color": "red" }, "1": { "text": "VERBUNDEN", "color": "green" } } }
        ]
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Ausstehende Genehmigungen",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "ha_repairs_pending_approvals",
          "legendFormat": "Ausstehend"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 1, "color": "yellow" }, { "value": 3, "color": "red" }] }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Knowledge-Einträge",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "sum(ha_vector_store_entries)",
          "legendFormat": "Einträge"
        }
      ],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Agent-Laufzeit (p95)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(ha_agent_run_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 {{agent_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Erkannte Findings",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(ha_findings_detected_total[5m]) * 300",
          "legendFormat": "{{severity}} / {{category}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HTTP-Antwortzeiten (p95)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(ha_http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "{{method}} {{path}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Reparaturen (vorgeschlagen / angewendet)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(ha_repairs_proposed_total[5m]) * 300",
          "legendFormat": "Vorgeschlagen {{risk_level}}"
        },
        {
          "expr": "rate(ha_repairs_applied_total[5m]) * 300",
          "legendFormat": "Angewendet {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Security-Issues erkannt",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(ha_security_issues_total[5m]) * 300",
          "legendFormat": "{{check_type}} / {{severity}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "LLM-Aufrufzeiten (p95)",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(ha_llm_call_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 {{backend}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      }
    }
  ]
}
